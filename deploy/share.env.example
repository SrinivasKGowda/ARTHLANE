# Copy to share.env to turn on email sign-in for the link shared from your PC. Never commit share.env.
# From a free Brevo account: Settings > SMTP & API. MAIL_FROM must be a sender address verified in Brevo.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Arthlane <you@example.com>
