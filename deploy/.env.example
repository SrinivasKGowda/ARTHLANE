# Copy to .env on the server and fill in. Never commit .env.

# The main address of the site, without https://
DOMAIN=arthlane.in
# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=you@example.com

# Generate each with: openssl rand -base64 48
POSTGRES_PASSWORD=
ARTHLANE_JWT_SECRET=

# SMTP account that sends sign-in codes (Zoho Mail, Amazon SES, Brevo, Resend and similar all work).
# Leave MAIL_HOST empty and nobody can sign in.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Arthlane <no-reply@arthlane.in>
